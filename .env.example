# Environment Variables for Bookkeeper Web App

# Data storage directory (relative to project root)
DATA_DIR=./data

# For production, you might want to use external storage
# STORAGE_TYPE=filesystem
# STORAGE_PATH=/tmp/bookkeeper-data

# Optional: Database URL for future use
# DATABASE_URL=

# Optional: External storage (AWS S3, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=